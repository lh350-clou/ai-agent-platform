# ============================================================
# 环境变量模板 —— AI 智能知识库 Agent 平台
#
# 使用方法：
#   cp .env.example .env
# 然后按需修改 .env 中的值。
#
# 注意：.env 存放真实配置（后续会包含 API Key、数据库密码），
# 已被 .gitignore 忽略，请勿提交；本文件可以提交。
# ============================================================

# ---------- 应用基础信息 ----------
APP_NAME=AI 智能知识库 Agent 平台
APP_VERSION=0.1.0
# 是否开启调试模式（本地开发建议 true，生产改为 false）
DEBUG=true

# ---------- 服务监听地址 ----------
HOST=0.0.0.0
PORT=8000

# ---------- PostgreSQL 数据库 ----------
# 本文件可以提交到版本库，所以 POSTGRES_PASSWORD 留空、不要填真实值，
# 真实密码只写在 .env（已被 .gitignore 忽略）。

# 主机名取决于「谁在连数据库」：
#   本机直接跑 uvicorn          -> localhost
#   backend 也放进 Docker Compose -> pg16（compose 里的服务名）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 真实密码填在 .env 里，例如 POSTGRES_PASSWORD=你的密码
POSTGRES_PASSWORD=
POSTGRES_DB=agent_db
