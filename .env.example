# ============================================================
# 环境变量模板 —— AI 智能知识库 Agent 平台
#
# 使用方法：
#   cp .env.example .env
# 然后按需修改 .env 中的值。
#
# 注意：.env 存放真实配置（后续会包含 API Key、数据库密码），
# 已被 .gitignore 忽略，请勿提交；本文件可以提交。
# ============================================================

# ---------- 应用基础信息 ----------
APP_NAME=AI 智能知识库 Agent 平台
APP_VERSION=0.1.0
# 是否开启调试模式（本地开发建议 true，生产改为 false）
DEBUG=true

# ---------- 服务监听地址 ----------
HOST=0.0.0.0
PORT=8000

# ---------- PostgreSQL 数据库 ----------
# 本文件可以提交到版本库，所以 POSTGRES_PASSWORD 留空、不要填真实值，
# 真实密码只写在 .env（已被 .gitignore 忽略）。

# 主机名取决于「谁在连数据库」：
#   本机直接跑 uvicorn          -> localhost
#   backend 也放进 Docker Compose -> pg16（compose 里的服务名）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 真实密码填在 .env 里，例如 POSTGRES_PASSWORD=你的密码
POSTGRES_PASSWORD=
POSTGRES_DB=agent_db

# ---------- DeepSeek 大模型 ----------
# 本文件可以提交到版本库，所以这里只留占位符，不要填真实 Key。
# 去 https://platform.deepseek.com 申请后，把真实 Key 写进 .env：
#   DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=

# API 地址，一般不用改。SDK 会自动在后面拼 /chat/completions，
# 所以这里不要带 /v1 或具体路径。
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 对话模型：deepseek-chat 为通用对话模型
DEEPSEEK_MODEL=deepseek-chat

# ---------- 硅基流动 Embedding ----------
# 用途：把文档切片转成向量，供 Milvus 检索使用。
# 为什么向量化不放在 DeepSeek：DeepSeek 官方只有生成模型，没有 embedding 接口。
# 同样只留占位符，真实 Key 写进 .env：
#   SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx
SILICONFLOW_API_KEY=

# API 地址。注意这里带 /v1 后缀，和上面的 DEEPSEEK_BASE_URL 写法不同，
# 是各家路径约定不一样，不是笔误。SDK 会在这后面拼 /embeddings。
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# 向量模型。换模型往往意味着向量维度也变了，换之前务必先看下面一行。
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3

# 向量维度。必须和 Milvus collection 的实际维度一致 ——
# 维度在创建 collection 时就固定了，事后改不了，只能重建集合并重新向量化全部文档。
# bge-m3 输出 1024 维。
EMBEDDING_DIM=1024

# ---------- 文件上传限制 ----------
# 单个上传文件的大小上限（单位：字节）。默认 10485760 = 10 MiB。
# 超过这个大小的上传请求会被拒绝并返回 HTTP 413。
# 调小时注意：太小的上限会把正常文档也挡在外面。
MAX_UPLOAD_SIZE_BYTES=10485760
