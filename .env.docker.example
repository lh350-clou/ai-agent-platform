# ============================================================
# Docker Compose 环境变量模板
#
# 使用方法：
#   cp .env.docker.example .env.docker
# 然后把真实的 API Key 填进去。
#
# 为什么单独一份而不是复用 .env：
#   Docker 里的主机名和本地开发【不一样】。容器里的 localhost 指的是
#   容器自己，连不上任何东西，必须写成 compose 里的服务名。
#   两套配置分开，改 Docker 的配置不会影响本地开发，反之亦然。
#
# .env.docker 已被 .gitignore 忽略（.env.* 规则），不会进版本库；
# 本文件是模板，可以提交。
# ============================================================

# ---------- PostgreSQL ----------
# 注意 POSTGRES_HOST 是 compose 里的【服务名】，不是 localhost。
# 容器里的 localhost 指的是容器自己，写 localhost 会连不上数据库，
# 而且报错信息只会说「连接被拒绝」，很容易误判成数据库没启动。
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# 必须自己设一个，不要用 postgres 这类弱密码。
# 没有设置时 compose 会直接报错退出（见 docker-compose.yml 里的 :? 语法），
# 这是刻意的：宁可启动失败，也不要悄悄用一个所有人都知道的密码。
POSTGRES_PASSWORD=
POSTGRES_DB=agent_db

# 说明：本项目【不使用】DATABASE_URL。
# 连接串由 config.py 从上面的 POSTGRES_* 各字段拼出来（见 database_url 属性），
# 这样密码可以单独用 SecretStr 包住，不会被打印进日志。
# 如果你习惯用一整条 DATABASE_URL，可以自行在代码里接，但当前它是无效的：
# DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/agent_db

# ---------- Milvus ----------
# 同样是服务名，不是 localhost。
MILVUS_HOST=milvus
MILVUS_PORT=19530

# ---------- DeepSeek（生成回答）----------
# 填真实 Key。注意这是公网 HTTPS 地址，容器直接访问外网即可。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---------- 硅基流动（BGE-M3 向量化）----------
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ---------- 应用行为 ----------
# 生产部署建议改成 false：DEBUG=true 会把每条 SQL 都打进日志，既吵又慢。
DEBUG=false

MAX_UPLOAD_SIZE_BYTES=10485760

# 允许跨域的前端地址，逗号分隔。
# 默认是你的浏览器访问前端的地址（80 端口），不是容器的服务名 ——
# CORS 校验的是【浏览器地址栏里的地址】，浏览器不认识服务名。
CORS_ALLOW_ORIGINS=http://localhost,http://127.0.0.1

# ---------- MCP ----------
# MCP Server 以后台子进程方式运行在后端容器里，不单独暴露端口。
MCP_SERVER_MODULE=app.mcp_server.server
MCP_TOOL_TIMEOUT_SECONDS=15

# ---------- 前端构建参数（可选）----------
# 这个值在【构建时】烧进前端产物，改完要重新 build 才生效
# （docker compose up -d --build）。
VITE_API_BASE_URL=http://localhost:8000
